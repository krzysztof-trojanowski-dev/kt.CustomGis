<Window x:Class="kt.CustomGis.AppMain.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:kt.CustomGis.AppMain"
        xmlns:viewModels="clr-namespace:kt.CustomGis.AppMain.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}"
        Title="SettingsWindow" Height="450" Width="800">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"></RowDefinition>
        <RowDefinition Height="Auto"></RowDefinition>
        <RowDefinition Height="Auto"></RowDefinition>
    </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250"></ColumnDefinition>
        <ColumnDefinition Width="*"></ColumnDefinition>
      </Grid.ColumnDefinitions>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="0" Margin="5">
          <Button Content="Zamknij" Command="{Binding CloseCommand}" Padding="10,2" Margin="0,0,8,0"/>
          <Button Content="Zapisz" Command="{Binding SaveCommand}" Padding="10,2" Margin="0,0,8,0"/>
        </StackPanel>

    <TextBlock Text="Ustawienia aplikacji" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="1"/>

    <TextBlock Text="Liczba wierszy na stronie" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"/>
    <ComboBox ItemsSource="{Binding AvailablePageSizes}" 
              SelectedItem="{Binding SelectedPageSize, Mode=TwoWay}" Width="100" Margin="8, 8" 
              Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left"/>
  </Grid>
</Window>
